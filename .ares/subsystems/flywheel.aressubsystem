{
  "schemaVersion": 11,
  "documentId": "flywheel",
  "uid": "flywheel",
  "displayName": "Shooter flywheel",
  "kotlinTypeName": "FlywheelSubsystem",
  "description": "Optional DECODE shooter flywheel with cached RPM/current feedback, closed-loop velocity control, bounded brownout effort, feedback-fault latching, and explicit neutral recovery.",
  "platform": "FTC",
  "revision": 1,
  "hardware": [
    {
      "hardwareId": "flywheelMotor",
      "uid": "flywheelMotor",
      "displayName": "Shooter flywheel motor",
      "kind": "MOTOR",
      "connection": { "hardwareMapName": "shooter" },
      "measurements": [
        {
          "fieldId": "currentRpm",
          "source": "MOTOR_VELOCITY_NATIVE_PER_SECOND",
          "scale": 2.142857142857143,
          "maxAgeMs": 150,
          "validMinimum": -6000.0,
          "validMaximum": 6000.0
        },
        {
          "fieldId": "currentAmps",
          "source": "MOTOR_CURRENT_AMPS",
          "maxAgeMs": 150,
          "validMinimum": 0.0
        }
      ],
      "required": false,
      "safeOutput": 0.0,
      "description": "Configured in the FTC Robot Controller hardware map as 'shooter'. The adapter samples encoder velocity and current once per loop."
    }
  ],
  "stateFields": [
    {
      "fieldId": "flywheelActive",
      "uid": "flywheelActive",
      "displayName": "Spin requested",
      "type": "BOOLEAN",
      "role": "TARGET",
      "defaultBoolean": false,
      "description": "Immutable Redux enable intent. The intake interlock and fault latch may still force neutral output."
    },
    {
      "fieldId": "targetRpm",
      "uid": "targetRpm",
      "displayName": "Target speed",
      "type": "DOUBLE",
      "role": "TARGET",
      "unit": "rpm",
      "defaultNumber": 0.0,
      "minimum": 0.0,
      "maximum": 6000.0,
      "description": "Scoring speed stays constant during brownout limiting; only available effort is reduced."
    },
    {
      "fieldId": "currentRpm",
      "uid": "currentRpm",
      "displayName": "Measured speed",
      "type": "DOUBLE",
      "role": "MEASUREMENT",
      "unit": "rpm",
      "defaultNumber": 0.0,
      "minimum": -6000.0,
      "maximum": 6000.0,
      "description": "Cached encoder speed converted from ticks per second using 28 ticks per motor revolution."
    },
    {
      "fieldId": "currentAmps",
      "uid": "currentAmps",
      "displayName": "Flywheel current",
      "type": "DOUBLE",
      "role": "MEASUREMENT",
      "unit": "A",
      "defaultNumber": 0.0,
      "minimum": 0.0,
      "description": "Cached current used by power management and diagnostics."
    },
    {
      "fieldId": "velocityValid",
      "uid": "velocityValid",
      "displayName": "Velocity feedback valid",
      "type": "BOOLEAN",
      "role": "STATUS",
      "defaultBoolean": false,
      "description": "False when the latest encoder observation failed or was non-finite."
    },
    {
      "fieldId": "feedbackFaultLatched",
      "uid": "feedbackFaultLatched",
      "displayName": "Feedback fault latched",
      "type": "BOOLEAN",
      "role": "STATUS",
      "defaultBoolean": false,
      "description": "Invalid velocity while active latches after 150 ms and clears only after disabled healthy feedback."
    }
  ],
  "controlLoops": [
    {
      "loopId": "flywheelVelocityControl",
      "uid": "flywheelVelocityControl",
      "displayName": "Flywheel velocity control",
      "strategy": "VELOCITY_PID",
      "actuatorId": "flywheelMotor",
      "targetFieldId": "targetRpm",
      "measurementFieldId": "currentRpm",
      "kP": 0.001,
      "kI": 0.0,
      "kD": 0.0,
      "feedforward": {
        "kind": "SIMPLE_MOTOR",
        "kS": 0.0,
        "kV": 0.002,
        "kA": 0.0
      },
      "tolerance": 20.0,
      "minimumOutput": -12.0,
      "maximumOutput": 12.0,
      "description": "Uses the REV hub velocity controller at full effort and cached-feedback software control when brownout management limits effort."
    }
  ],
  "tuningParameters": [],
  "template": "VELOCITY_CONTROLLED_MECHANISM",
  "implementation": {
    "kind": "HAND_AUTHORED",
    "ownership": "USER_OWNED",
    "modulePath": ":TeamCode",
    "sourceFiles": [
      "TeamCode/src/main/java/org/firstinspires/ftc/teamcode/subsystems/Subsystems.kt",
      "TeamCode/src/main/java/org/firstinspires/ftc/teamcode/hardware/FtcFlywheelIO.kt"
    ],
    "subsystemClassName": "org.firstinspires.ftc.teamcode.subsystems.FlywheelSubsystem",
    "ioContractClassName": "com.areslib.hardware.actuator.FlywheelIO",
    "hardwareAdapterClassName": "org.firstinspires.ftc.teamcode.hardware.FtcFlywheelIO",
    "simulation": {
      "support": "HAND_AUTHORED_SIMULATOR",
      "adapterClassName": "org.firstinspires.ftc.teamcode.hardware.FtcFlywheelIO",
      "interaction": {
        "role": "PROJECTILE_LAUNCHER",
        "triggerActuatorId": "flywheelMotor",
        "triggerThreshold": 1.0,
        "storageCapacity": 1,
        "launchSpeedMps": 8.0,
        "launchElevationDeg": 45.0
      }
    },
    "teaching": {
      "level": "INTERMEDIATE",
      "summary": "A closed-loop mechanism example showing cached velocity feedback, feedforward plus feedback, power-aware effort limiting, interlocks, and fail-closed recovery.",
      "documentationPath": "docs/examples/HAND_AUTHORED_MECHANISMS.md",
      "concepts": [
        "Closed-loop velocity control",
        "Feedforward plus feedback",
        "Cached sensor validity",
        "Power-aware effort limiting",
        "Explicit neutral recovery"
      ]
    }
  },
  "capabilityActionKeys": [
    "flywheel.prepare",
    "flywheel.stop"
  ],
  "safety": {
    "feedbackTimeoutMs": 150,
    "homing": { "method": "NONE" },
    "requiresCalibration": false,
    "requiresConfigurationHealth": true,
    "requiresCurrentMonitoring": true,
    "latchOutputFaults": true,
    "requiresExplicitNeutralRecovery": true,
    "telemetryEnabled": true,
    "zeroAllocationPeriodic": true
  },
  "autonomousResourceKey": "flywheel",
  "requiredAtStartup": false,
  "generateMockIo": false,
  "generateTest": false
}
